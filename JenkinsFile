pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                git 'https://github.com/Hexdoktor/OTP1_inclass1_assignment'
            }
        }
        stage('Build') {
            steps {
                bat 'mvn clean install'
            }
        }
        stage('Test') {
            steps {
                bat 'mvn test'
            }
        }
        stage('Code Coverage') {
            steps {
                bat 'mvn jacoco:report'
            }
        }
        stage('Publish Test Results') {
            steps {
                junit '**/target/surefire-reports/*.xml'
            }
        }
        stage('Publish Coverage Report') {
            steps {
                jacoco()
            }
        }
        stage('Docker Build') {
            steps {
                bat 'docker build -t hexdoktor/temp_converter_docker:%BUILD_NUMBER% .'
                bat 'docker tag hexdoktor/temp_converter_docker:%BUILD_NUMBER% hexdoktor/temp_converter_docker:latest'
            }
        }
        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    // --- DEBUG: remove after checking ---
                    bat 'echo [%DOCKER_USER%]'
                    bat 'echo %DOCKER_PASS%X'
                    // --- end debug ---
                    bat 'echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin'
                    bat 'docker push hexdoktor/temp_converter_docker:%BUILD_NUMBER%'
                    bat 'docker push hexdoktor/temp_converter_docker:latest'
                }
            }
        }
    }
}